VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY

# Production error monitoring. VITE_SENTRY_DSN is safe to expose to the browser.
VITE_SENTRY_DSN=https://YOUR_PUBLIC_KEY@YOUR_SENTRY_HOST/YOUR_PROJECT_ID

# Build-only Sentry secrets for readable stack traces. Never prefix the token with VITE_.
SENTRY_AUTH_TOKEN=YOUR_SENTRY_AUTH_TOKEN
SENTRY_ORG=YOUR_SENTRY_ORGANIZATION_SLUG
SENTRY_PROJECT=YOUR_SENTRY_PROJECT_SLUG
